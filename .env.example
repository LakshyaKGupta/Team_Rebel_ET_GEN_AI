# Database
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Groq AI API (free, fast - get key from https://console.groq.com)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"

# Frontend Configuration
FRONTEND_ORIGIN="http://localhost:3000"
FRONTEND_ORIGINS="http://localhost:3000,http://localhost:3001"

# News APIs
# NewsAPI - https://newsapi.org
NEWSAPI_KEY=""

# GNews - https://gnews.io
GNEWS_API_KEY=""

# NewsData.io - https://newsdata.io (free tier available)
NEWS_DATA_KEY=""

# RSS feeds (optional, comma separated)
RSS_FEEDS=""

# NER (Named Entity Recognition)
NER_ENABLED="true"
NER_MODEL_NAME="en_core_web_sm"

# Ingestion Settings
INGEST_PROVIDER="live"
INGEST_AUTO_START="false"
INGEST_SOURCE="rss"
INGEST_INTERVAL_MINUTES="30"

# Cache Configuration
NEWS_CACHE_TTL_SECONDS="60"
STORY_CACHE_TTL_SECONDS="120"
